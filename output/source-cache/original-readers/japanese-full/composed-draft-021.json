  "sentences": [
    {
      "japanese": "好きな野球と好きなダンスと好きなジャズです。",
      "chinese": "喜歡的棒球、喜歡的舞蹈和喜歡的爵士樂。",
      "targets": [
        "野球",
        "ダンス",
        "ジャズ"
      ]
    },
    {
      "japanese": "コンサートとカラオケと歌舞伎のチケットです。",
      "chinese": "是音樂會、卡拉OK和歌舞伎的票。",
      "targets": [
        "コンサート",
        "カラオケ",
        "歌舞伎",
        "チケット"
      ]
    },
    {
      "japanese": "細かいお金をください。",
      "chinese": "請給我零錢。",
      "targets": [
        "細かいお金"
      ]
    },
    {
      "japanese": "もしもし。チケットは駄目ですか。",
      "chinese": "喂。票不行嗎？",
      "targets": [
        "もしもし",
        "チケット",
        "駄目ですか"
      ]
    },
    {
      "japanese": "残念です。また今度カラオケです。",
      "chinese": "真可惜。下次再唱卡拉OK。",
      "targets": [
        "残念です",
        "また今度",
        "カラオケ"
      ]
    },
    {
      "japanese": "色々な男の人と色々な女の人です。",
      "chinese": "各式各樣的男人和各式各樣的女人。",
      "targets": [
        "色々な",
        "男の人",
        "女の人"
      ]
    },
    {
      "japanese": "男の人は野球、女の人はダンスです。",
      "chinese": "男人打棒球，女人跳舞。",
      "targets": [
        "男の人",
        "野球",
        "女の人",
        "ダンス"
      ]
    }
  ]
}