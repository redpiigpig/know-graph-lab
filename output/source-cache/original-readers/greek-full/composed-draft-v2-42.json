    {"greek": "ἰσχυρῶς πεφυρμένος τὴν μέριμναν", "chinese": "他強烈地把那憂慮攪混了。", "targets": ["ἰσχυρῶς", "φύρω", "μέριμνα"]},
    {"greek": "ἀπορούμενοι ἐκρέμασαν τὸ εὐθαλῆ", "chinese": "他們不知所措地把那繁茂之物掛了起來。", "targets": ["ἀπορέω", "κρεμάννυμι", "εὐθαλής"]},
    {"greek": "ἐν ποικιλίᾳ μεταφέρειν τὴν δειλίαν", "chinese": "在多樣之中把那膽怯轉移開。", "targets": ["ποικιλία", "μεταφέρω", "δειλία"]},
    {"greek": "ἀνέθηκαν ἰσχυρῶς, καὶ ἔοικεν", "chinese": "他們堅決地獻上了，看來就是如此。", "targets": ["ἀνατίθημι", "ἰσχυρῶς", "ἔοικα"]},
    {"greek": "ἐπειρῶντο τὴν φιλοσοφίαν ἐπονομάσαι", "chinese": "他們試著為那哲學命名。", "targets": ["πειράω", "φιλοσοφία", "ἐπονομάζω"]},
    {"greek": "τὴν πατρικὴν διαφορὰν τῶν νοερῶν", "chinese": "那些屬靈者的父系差異。", "targets": ["πατρικός", "διαφορά", "νοερός"]},
    {"greek": "ἐν φιλοσοφίᾳ ἡ μέριμνα καὶ ἡ δειλία", "chinese": "哲學裡有那憂慮與那膽怯。", "targets": ["φιλοσοφία", "μέριμνα", "δειλία"]}
