    {"greek": "ὑπήκοος ἐμαλακίσθη διὰ τὴν βλάβην", "chinese": "那順從的人因那損害而變虛弱。", "targets": ["ὑπήκοος", "μαλακίζω", "βλάβη"]},
    {"greek": "κεῖραι τὸν ἄφωνον ἐν μώλωπι", "chinese": "在傷痕中剃那啞的人。", "targets": ["κείρω", "ἄφωνος", "μώλωψ"]},
    {"greek": "ἄμεμπτος ἐν σποδῷ καὶ κρυφίοις", "chinese": "在灰中與隱密處無可指責。", "targets": ["ἄμεμπτος", "σποδός", "κρύφιος"]},
