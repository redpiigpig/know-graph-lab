  "sentences": [
    {"greek": "ἐν τῇ στρατιᾷ κινδυνεύομεν ἐν τάχει", "chinese": "我們在軍營中迅速陷入危險。", "targets": ["στρατία", "κινδυνεύω", "τάχος"]},
    {"greek": "τὰ νήπια ἐν ἐπιγνώσει νεφῶν", "chinese": "那些嬰孩在對雲的認識裡。", "targets": ["νήπιος", "ἐπίγνωσις", "νέφος"]},
    {"greek": "ἡ στεῖρα ἔσω ἐλεήμων", "chinese": "那不生育的婦人在裡面是慈悲的。", "targets": ["στείρος", "ἔσω", "ἐλεήμων"]},
    {"greek": "ἐν μύθοις ἐπλούτησαν καὶ ἐτράπησαν", "chinese": "他們藉傳說致富，又轉離了。", "targets": ["μῦθος", "πλουτέω", "τρέπω"]},
    {"greek": "ἀπεδέξατο τὴν ὁμοιότητα ἀδιακρίτως", "chinese": "他不分人情地接納了那相似。", "targets": ["ἀποδέχομαι", "ὁμοιότης", "ἀδιάκριτος"]},
    {"greek": "ἀποδεξάμενοι τὴν συνήθειαν καὶ τὴν εὐταξίαν", "chinese": "他們接納了那習俗與那秩序。", "targets": ["ἀποδέχομαι", "συνήθεια", "εὐταξία"]},
    {"greek": "ἐλεήμονα καὶ ἀδιάκριτον τὴν συνήθειαν", "chinese": "那慈悲又不分人情的習俗。", "targets": ["ἐλεήμων", "ἀδιάκριτος", "συνήθεια"]}
