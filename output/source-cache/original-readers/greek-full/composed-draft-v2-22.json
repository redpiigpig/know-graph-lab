    {"greek": "θεωρίαν ὅμως περιλαβεῖν", "chinese": "儘管如此，要包含那觀想。", "targets": ["θεωρία", "ὅμως", "περιλαμβάνω"]},
    {"greek": "σώφρων ἀρκεῖσθαι σχίσματα", "chinese": "那謹慎的人對這些分裂知足。", "targets": ["σώφρων", "ἀρκέω", "σχίσμα"]},
    {"greek": "πολιτεύεσθαι καὶ ὑπενεγκεῖν", "chinese": "要生活為人，並且忍受。", "targets": ["πολιτεύω", "ὑποφέρω"]},
    {"greek": "κατέστρεψεν καὶ ἐμέτρησεν ἡσύχιον", "chinese": "他推翻了，也量了那安靜的。", "targets": ["καταστρέφω", "μετρέω", "ἡσύχιος"]},
