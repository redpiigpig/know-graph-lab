  "note": "σχίσμα 沒有單數與格 σχίσματι 進語料。",
  "sentences": [
    {"greek": "συγγράμματα βαρβάρων ἀθεότητα", "chinese": "蠻族著作中的無神。", "targets": ["σύγγραμμα", "βάρβαρος", "ἀθεότης"]},
