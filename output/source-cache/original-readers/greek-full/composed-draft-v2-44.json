  "sentences": [
    {"greek": "μιαρώτατε, ἐν συμφορᾷ οἱ ἀνόσιοι", "chinese": "最污穢的人哪，那些不敬虔者身處災難中。", "targets": ["μιαρός", "συμφορά", "ἀνόσιος"]},
    {"greek": "καθήκει τὰ ἤθη τῷ κανόνι", "chinese": "那些品性合乎那準繩。", "targets": ["καθήκω", "ἦθος", "κανών"]},
    {"greek": "σεμνῶς ἐν τῇ ἀδελφότητι ἀκέραιοι", "chinese": "在弟兄團體中莊重而純正。", "targets": ["σεμνῶς", "ἀδελφότης", "ἀκέραιος"]},
    {"greek": "ἠνάγκασεν ἀπαλλαγῆναι καὶ ὑπέδειξεν", "chinese": "他強迫人脫離，又作了指示。", "targets": ["ἀναγκάζω", "ἀπαλλαξείω", "ὑποδείκνυμι"]},
    {"greek": "ὑπομιμνήσκων τὴν φροντίδα ἠλλοίωσεν", "chinese": "他提醒那顧慮，並使之改變。", "targets": ["ὑπομιμνῄσκω", "φροντίς", "ἀλλοιόω"]},
    {"greek": "ἐξαριθμῆσαι τοὺς κανόνας καὶ διελεγχθῶμεν", "chinese": "要數點那些規範，好讓我們受到駁斥。", "targets": ["ἐξαριθμέω", "κανών", "διελέγχω"]},
    {"greek": "ἐν συμφοραῖς ὑπεμνήσθη τῆς ἀδελφότητος", "chinese": "他在諸般災難中想起了那弟兄團體。", "targets": ["συμφορά", "ὑπομιμνῄσκω", "ἀδελφότης"]}
  ]
