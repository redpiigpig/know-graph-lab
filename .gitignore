# ══════════════════════════════════════════════════════════════════
# 本 repo 只放「網站跑得起來所需的原始碼與策展資料」。
#   ‧ 成品（PDF/DOCX/影片/簡報/單字卡）→ Drive 資料/知識圖工作室/
#   ‧ 下載素材（z-lib/TRC/掃描原檔）    → Drive 電子圖書館/
#   ‧ 快取／中繼／一次性工作檔          → 本機，不進版控也不上 Drive
# 規則全文與各類去處對照表：docs/repo-hygiene.md
# 根目錄禁止新增任何檔案（工具鏈設定檔除外），詳見同一份文件。
# ══════════════════════════════════════════════════════════════════

# ── 成品：一律不進版控，正本在 Drive ──────────────────────────────
# output/ 預設全擋。唯一例外是 source-cache 裡人工校訂、不可重生的策展
# JSON（詞表計畫、gloss 中譯、配圖對照）與音訊 manifest —— 這些要能被
# review 與回溯，所以逐條放行；產出的 PDF/DOCX/XLSX 一概不留。
/output/**
# 放行的是各語料夾「頂層」的策展 JSON／審閱筆記；底下 sources/、
# morphhb-src/、iconify/ 那些下載回來的第三方語料一律不放行。
!/output/source-cache/
!/output/source-cache/*.json
!/output/source-cache/flashcards/
!/output/source-cache/flashcards/*.json
!/output/source-cache/original-readers/
!/output/source-cache/original-readers/*.json
!/output/source-cache/original-readers/greek-full/
!/output/source-cache/original-readers/greek-full/*.json
!/output/source-cache/original-readers/hebrew-full/
!/output/source-cache/original-readers/hebrew-full/*.json
!/output/source-cache/original-readers/hebrew-full/*.md
!/output/source-cache/original-readers/latin-full/
!/output/source-cache/original-readers/latin-full/*.json
!/output/source-cache/original-readers/latin-full/*.md
!/output/source-cache/original-readers/latin-full/collins-readings/
!/output/source-cache/original-readers/latin-full/collins-readings/*.json
!/output/source-cache/original-readers/japanese-full/
!/output/source-cache/original-readers/japanese-full/*.json
!/output/source-cache/original-readers/japanese-full/*.md
!/output/source-cache/original-readers/japanese-full/aozora/
!/output/source-cache/original-readers/japanese-full/aozora/manifest.json
!/output/original-readers/
!/output/original-readers/audio/
!/output/original-readers/audio/**/
!/output/original-readers/audio/**/manifest.json

# 短影片（reels）→ Drive 知識圖工作室/影片
/影片/
# z-library / TRC 下載暫存 → Drive 電子圖書館/_待入庫
/z-lib/
/z-library_獵表*.txt   # 只擋根目錄；獵表的正確位置是 .claude/skills/ebook-collected-works/

# ── 快取 / 中繼 / 一次性工作檔 ─────────────────────────────────────
/tmp/
/.tmp/
/qa/
/docs/hcu-manual-qa/
/.agents/
/_whisper_venv/

# 背景艦隊的 runtime state（pid／lock／pause 旗標）：程序自己寫，每次執行都變，
# 對別的機器毫無意義。進度 checkpoint 與品質帳本（*.json / *.jsonl）仍然追蹤。
/scripts/state/*.pid
/scripts/state/*.lock
/scripts/state/*.pause.*
# supervisor 進度與冷卻旗標同理：程序每分鐘覆寫，續傳只在本機有意義。
/scripts/state/translation_supervisor.json
/scripts/state/translation_cloud_supervisor.json
/scripts/state/ocr_gemini_cooldown.json

# Nuxt
.nuxt
.output
.data
.cache
# Photo thumb disk cache (regenerated by /api/photos/thumb on demand + prewarm script)
/.cache/thumbs/

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json 要 commit（CI 的 npm ci / setup-node cache 需要它）
yarn.lock
pnpm-lock.yaml

# Environment
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.DS_Store

# Build
dist
build
out

# Logs
logs
*.log

# Python
__pycache__/
*.py[cod]
venv/
scripts/raw_data/

# Temporary
*.tmp
uploads/
temp/

# Raw data files (large CSV/Excel, imported via scripts)
stores/*
# …except Pinia store source files (Nuxt auto-imports stores/*.ts)
!stores/*.ts

# 龐君華會督文集典藏：原 nonchurch-nuxt 轉運資料夾（已搬入 pages/, layouts/, server/api/, stores/, scripts/）
/pong-archive/

# Sermon transcript working area — outputs shipped via skill, not source-tracked
/tmp_sermon/

# Local scheduler / new-book staging inside skill folders (binaries, lock files)
/.claude/scheduled_tasks.lock
/.claude/skills/*/new-book/
# Temp working directories (sermon audio downloads, FHL article scrape, methodist paper PDFs)
/_tmp_audio/
/tmp_fhl/
/tmp_methodist/
/tmp_cmpc/
/tmp_talk/

/龐君華牧師歷年事工報告/

# Photo library index — local file, regenerated by scripts/build_photo_index.py
/scripts/photo_index.json
# Rename / classify run output (regenerated per run)
/scripts/photo_rename_report*.json
/scripts/photo_rename_log.jsonl
/scripts/photo_classification_report.json
/scripts/photo_move_log.jsonl
/scripts/photo_rollback_log.jsonl
# One-off scripts for batch imports (kept local, not source-tracked)
/scripts/_*.py
# One-off node helpers / local verification harnesses (e.g. Playwright UI checks)
/scripts/_*.mjs
# One-off data snapshots / indexes regenerated by crawlers
/scripts/_*.json
# Per-script output directories (e.g. scripts/_denzinger_toc/dh_titles.json)
/scripts/_*/
# Per-script `.bak` snapshots (e.g. data/creeds/.../*-chinese.txt.bak)
# git history already preserves the prior version; the bak is redundant.
*.bak
.claude/skills/ebook-collected-works/mueller_data/_queue.lock

# Panikkar self-translate cache holds COPYRIGHTED source text (src fields) — never commit
.claude/skills/ebook-collected-works/panikkar_data/

# Collected-works pipeline 產出 JSON（canonical 在 DB；jung 含版權 Hull 英譯）— 本機工作檔，不進版控
.claude/skills/ebook-collected-works/jung_data/
.claude/skills/ebook-collected-works/mueller_data/

# Script runtime 快取/進度檔（app 不引用，腳本每次執行重生）
/data/local_inventory.json
/data/parse_progress.txt
/data/herald_detect_cache.json

# pytest
.pytest_cache/

# Interview-book OCR transcriptions hold COPYRIGHTED book text — canonical store is the DB (lit_review_sections)
scripts/data/huimin_liushi_ganen/
scripts/data/lizhifu_fuchen/
scripts/data/wulaoze_jiazi/
scripts/data/yinshun_jiuzhi/

# Interview-book / festschrift SOURCE PHOTO folders (copyrighted scans, local-only; OCR text → DB)
/六十感恩紀：惠敏法師訪談錄/
/浮塵掠影：李志夫先生訪談錄/
/台灣佛教一甲子：吳老擇先生訪談錄/
/印順導師九秩華誕祝壽文集/
scripts/data/lin_juece/
scripts/data/lin_rulaizang/
scripts/data/yinshunpai_chengli/
scripts/data/hengqing_xingtan/
scripts/data/lin_kongxing/
scripts/data/wang_ronghe/

# 第三方版權論文 PDF（全文已 OCR 入 lit_review_sections，canonical 在 DB）
學問僧的生命書寫.pdf

# 媒體優化 ledger（runtime state）
scripts/transcode_ledger.json
scripts/heic_convert_ledger.json
.gcp/
.env.bak.*
/scripts/drive_ids.json

# 個人搞笑短影片（reels-piigpig）：影片檔進 git 備份；原始歌曲/中繼音檔不進（可由文案 URL 重抓，避免推原始版權音檔）
影片/**/*.mp3
影片/**/*.wav
影片/**/*.webm

# Greek reader keeper pass logs (regenerated every run)
output/source-cache/original-readers/greek-full/*.log

# OpenMoji artwork for the flashcard decks: a 44 MB third-party asset that
# scripts/match_flashcard_images.py re-downloads on demand.
output/source-cache/flashcards/openmoji-618/
output/source-cache/flashcards/openmoji.json

# Ecclesiastical Latin reader — downloaded build inputs, all reproducible.
# The curated outputs (plans, Chinese, glosses) are tracked; these are not.
output/source-cache/original-readers/latin-full/latVUC*
output/source-cache/original-readers/latin-full/UD_Latin-*
output/source-cache/original-readers/latin-full/ud-*.zip
output/source-cache/original-readers/latin-full/whitakers*
output/source-cache/original-readers/latin-full/latin-church/
output/source-cache/original-readers/latin-full/collins-pages/
output/source-cache/original-readers/latin-full/latin-lexicon.json
output/source-cache/original-readers/latin-full/vulgate-lexicon.json
output/source-cache/original-readers/latin-full/sigao-cache.json

# Latin reader draft audio: synthetic, to be replaced by real recordings.
# The manifest is tracked so the clip list and checksums stay reviewable.
output/original-readers/audio/latin/*.mp3
output/original-readers/audio/latin/*.wav

# 青空文庫下載的原文與全站書目（可重抓，不進版控；manifest 留著）
output/source-cache/original-readers/japanese-full/aozora/texts/
output/source-cache/original-readers/japanese-full/aozora/index.json

# 逐詞詞形分析：由本機的 MorphGNT 與 OSHB 標註重建得出，92 MB，
# 屬快取不屬策展。要部署到線上得另想去處（R2 或隨源碼重建）。
output/source-cache/scripture/morphology/
