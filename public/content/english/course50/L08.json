  "grammar_points": [
    {
      "title_zh": "① 詢問顏色：What color is it?",
      "explain_zh": "用 What color is it? 來問物件的顏色，答句用 It's + 顏色詞。可加深色詞 dark 或金屬色 silver 等。",
      "table": [
        [
          "問句",
          "答句",
          "例句"
        ],
        [
          "What color is the arrow?",
          "It's silver.",
          "What color is the arrow? It's silver."
        ],
        [
          "What color is the heart shape?",
          "It's red.",
          "What color is the heart shape? It's red."
        ]
      ]
    },
    {
      "title_zh": "② 詢問形狀與大小：What shape is it?",
      "explain_zh": "用 What shape is it? 來問物件的形狀，答句用 It's a + 形狀名詞。可搭配寬、窄、厚等形容詞描述大小。",
      "examples": [
        {
          "en": "What shape is the box? It's a cube.",
          "zh": "這個盒子什麼形狀？是立方體。"
        },
        {
          "en": "What shape is the sticker? It's an oval.",
          "zh": "這張貼紙什麼形狀？是橢圓形。"
        },
        {
          "en": "What shape is the ribbon? It's wide and thin.",
          "zh": "這條絲帶寬且薄。"
        }
      ]
    }
  ],
