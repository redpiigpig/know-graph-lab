  "grammar_points": [
    {
      "title_zh": "① 介系詞位置表",
      "explain_zh": "介系詞用來說明物體相對另一個物體的位置，常見的有 in、on、under、near、behind、beside、above、below。以下表格列出每個介系詞的意思與例句。",
      "table": [
        [
          "介系詞",
          "意思",
          "例句（英文）"
        ],
        [
          "in",
          "在…裡面",
          "The cat is in the box."
        ],
        [
          "on",
          "在…之上",
          "The book is on the table."
        ],
        [
          "under",
          "在…下方",
          "The shoes are under the chair."
        ],
        [
          "near",
          "在…附近",
          "The lamp is near the sofa."
        ],
        [
          "behind",
          "在…後面",
          "The ball is behind the door."
        ],
        [
          "beside",
          "在…旁邊",
          "The teddy bear is beside the pillow."
        ],
        [
          "above",
          "在…上面",
          "The picture is above the fireplace."
        ],
        [
          "below",
          "在…下面",
          "The rug is below the table."
        ]
      ]
    },
    {
      "title_zh": "② 使用 Where is…? 問位置",
      "explain_zh": "當我們想知道某件東西在哪裡時，可以用 Where is…? 來提問。回答通常會用介系詞短語來說明位置。以下是一些常見的問答範例。",
      "examples": [
        {
          "en": "Where is the remote control?",
          "zh": "遙控器在哪裡？"
        },
        {
          "en": "It is on the coffee table.",
          "zh": "它在咖啡桌上。"
        },
        {
          "en": "Where are your shoes?",
          "zh": "你的鞋子在哪裡？"
        },
        {
          "en": "They are under the bed.",
          "zh": "它們在床底下。"
        },
        {
          "en": "Where is the family photo?",
          "zh": "全家福照片在哪裡？"
        },
        {
          "en": "It is above the fireplace.",
          "zh": "它在壁爐上面。"
        },
        {
          "en": "Where is the cat?",
          "zh": "貓咪在哪裡？"
        },
        {
          "en": "It is behind the curtain.",
          "zh": "它在窗簾後面。"
        }
      ]
    }
