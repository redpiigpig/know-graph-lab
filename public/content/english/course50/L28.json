  "grammar_points": [
    {
      "title_zh": "① 位置介系詞對照表",
      "explain_zh": "以下表格列出八個常用位置介系詞的中文意思，以及簡單的圖解說明（僅用文字描述圖像情境），幫助學生直觀了解每個介系詞表示的位置關係。",
      "table": [
        [
          "介系詞",
          "中文意思",
          "圖解說明"
        ],
        [
          "in",
          "在…裡面",
          "蘋果放在盒子裡"
        ],
        [
          "on",
          "在…之上",
          "書放在桌子上"
        ],
        [
          "under",
          "在…下方",
          "鞋子放在床底下"
        ],
        [
          "near",
          "在…附近",
          "花瓶放在電視機旁邊"
        ],
        [
          "behind",
          "在…後面",
          "海報貼在門後面"
        ],
        [
          "beside",
          "在…旁邊",
          "燈放在沙發旁邊"
        ],
        [
          "above",
          "在…上面",
          "時鐘掛在門的上面"
        ],
        [
          "below",
          "在…下面",
          "地毯鋪在桌子下面"
        ]
      ]
    },
