      },
      {
        "en": "Tom dreams of being a king one day.",
        "zh": "湯姆夢想有一天成為國王。"
      },
      {
        "en": "He shares his idea with his friend Lily.",
        "zh": "他把他的主意告訴他的朋友莉莉。"
      },
      {
        "en": "Lily works as a nurse and helps with a case at the hospital.",
        "zh": "莉莉在醫院工作，是一名護士，並協助處理一個個案。"
      },
      {
        "en": "She thinks her work matters a lot and writes notes for a writer.",
        "zh": "她覺得她的工作很重要，並為一位作家寫筆記。"
      },
      {
        "en": "Lily also meets the queen during a charity meeting with a businessman.",
        "zh": "莉莉也在一次慈善會議中遇見女王，並有一位商人在場。"
      },
      {
        "en": "They talk about chance, business, and their future plans.",
        "zh": "他們談論機會、商業以及他們未來的計畫。"
      },
      {
        "en": "A fisherman and a police man tell them about their experience at sea.",
        "zh": "一位漁夫和一位警察告訴他們他們在海上的經驗。"
      }
    ]
  },
  "grammar_points": [
    {
      "title_zh": "① What do you do? / What does he do? 隨主詞換助動詞",
      "explain_zh": "當詢問職業時，根據主詞選擇助動詞 do 或 does。第一人稱單數 I 與第二人稱單數 you 使用 do；第三人稱單數 he/she/it 使用 does。",
      "table": [
        [
          "主詞",
          "助動詞",
          "問句範例"
        ],
        [
          "I",
          "do",
          "What do you do?"
        ],
        [
          "He/She/It",
          "does",
          "What does he do?"
        ],
        [
          "We/You/They",
          "do",
          "What do you do?"
        ]
      ]
    },
    {
      "title_zh": "② 回答職業時單數前面要加 a／an",
      "explain_zh": "當用 He is a … 或 She is an … 回答職業時，單數職業名詞前必須加不定冠詞 a 或 an。以元音音開頭的職業用 an，輔音音開頭用 a。",
      "examples": [
        {
          "en": "He is a teacher.",
          "zh": "他是老師。"
        },
        {
          "en": "She is an artist.",
          "zh": "她是藝術家。"
        }
      ]
    }
  ],
