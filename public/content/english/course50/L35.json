        [
          "I",
          "am",
          "wearing a T-shirt"
        ],
        [
          "He",
          "is",
          "wearing shorts"
        ],
        [
          "She",
          "is",
          "wearing a dress"
        ],
        [
          "We",
          "are",
          "wearing shoes"
        ],
        [
          "They",
          "are",
          "wearing hats"
        ]
      ]
    },
    {
      "title_zh": "② He has … 描述他人的外貌特徵",
      "explain_zh": "用 has (第三人稱單數) 或 have (其他人稱) + 形容詞或名詞，來說明頭髮、身高、體型等特徵。",
