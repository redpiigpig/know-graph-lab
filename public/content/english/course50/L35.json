  "grammar_points": [
    {
      "title_zh": "① 最高級的拼字規則與加 the",
      "explain_zh": "形容詞最高級用來比較三者或以上，必須在形容詞前加 the，並依照詞尾變化拼寫 -est。以下列出常見規則：",
      "table": [
        [
          "原級",
          "最高級",
          "拼寫說明"
        ],
        [
          "tall",
          "tallest",
          "直接加 -est"
        ],
        [
          "cute",
          "cutest",
          "詞尾 e，去掉 e 再加 -est"
        ],
        [
          "heavy",
          "heaviest",
          "詞尾 y，前面是輔音，改 y 為 i 再加 -est"
        ],
        [
          "pretty",
          "prettiest",
          "同上"
        ],
        [
          "fat",
          "fattest",
          "詞尾單輔音且前面有單一短母音，雙寫該輔音再加 -est"
        ],
        [
          "thin",
          "thinnest",
          "同上"
        ],
        [
          "long",
          "longest",
          "直接加 -est"
        ],
        [
          "short",
          "shortest",
          "雙寫 t 再加 -est"
        ],
        [
          "good",
          "best",
          "不規則，需特別記住"
        ]
      ]
    },
    {
      "title_zh": "② 比較級（兩者）與最高級（三者以上）的分工",
      "explain_zh": "比較級用來比較兩者，形態為 -er 或 more + 形容詞；最高級用來比較三者或以上，形態為 the + -est 或 the most + 形容詞。以下例句說明兩者的差異：",
      "examples": [
        {
          "en": "Amy is taller than Bob.",
          "zh": "艾米比鮑伯高。"
        },
        {
          "en": "Amy is the tallest in the class.",
          "zh": "艾米是班上最高的。"
        },
        {
          "en": "This dress is prettier than that one.",
          "zh": "這件裙子比那件更漂亮。"
        },
        {
          "en": "This is the prettiest dress in the store.",
          "zh": "這是商店裡最漂亮的裙子。"
        }
      ]
    }
