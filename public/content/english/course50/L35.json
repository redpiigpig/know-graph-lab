{
  "title_en": "My Outfit",
  "title_zh": "我的時尚穿搭",
  "grammar": "使用 I'm wearing… 描述正在穿的衣服，以及 He has … 描述他人的外貌特徵。",
  "intro_zh": "在這一課，我們將學習用 I'm wearing… 說出自己現在穿著什麼衣服，並用 He has … 描述朋友的身高、體型和髮型。透過圖片與對話，練習描述自己和他人的外表。",
  "can_do": [
    "能用 I'm wearing… 描述自己現在穿的衣服。",
    "能用 He has … 描述別人的髮長、身高和體型。",
    "能用美麗、帥氣、友善等形容詞評論自己的外表。"
  ],
  "reading": {
    "title_en": "A Day at the Pool",
    "title_zh": "泳池裡的快樂一天",
    "sentences": [
      {
        "en": "Today is Saturday, and I'm wearing a blue swimsuit.",
        "zh": "今天是星期六，我穿著一件藍色的泳衣。"
      },
      {
        "en": "I look pretty and cute in my new swimsuit.",
        "zh": "我在新泳衣裡看起來很漂亮又可愛。"
      },
      {
        "en": "My friend Lily is tall and thin, she has long hair.",
        "zh": "我的朋友莉莉很高又很瘦，她有長髮。"
      },
      {
        "en": "She looks beautiful and healthy when she swims.",
        "zh": "她游泳時看起來很美麗又很健康。"
      },
      {
        "en": "Another friend, Tom, is short and strong, he has short hair.",
        "zh": "另一個朋友湯姆很矮又很強壯，他有短髮。"
      },
      {
        "en": "Tom looks handsome and nice in his red swimsuit.",
        "zh": "湯姆穿著紅色泳衣時很英俊又很友善。"
      },
      {
        "en": "My little brother is young and fat, he is not heavy but very friendly and kind.",
        "zh": "我弟弟很年輕又有點胖，他不重但非常友善又親切。"
      },
      {
        "en": "The old lifeguard watches us carefully, he is kind and always helps.",
        "zh": "年老的救生員仔細地看着我們，他很親切且總是願意幫忙。"
      },
      {
        "en": "We all feel good after swimming, and the day is really good; if the weather is bad, we will stay home and read books.",
        "zh": "我們游泳後都感到很好，這天真的很棒；如果天氣不好，我們會待在家裡讀書。"
      }
    ]
  },
  "grammar_points": [
    {
      "title_zh": "① I'm wearing… 表示現在正在穿著的衣服",
      "explain_zh": "使用 be 動詞 (am/is/are) + wearing + 名詞，來說明說話者或他人此刻所穿的衣服。",
      "table": [
        [
          "主語",
          "be 動詞",
          "wearing + 衣服"
