  "grammar_points": [
    {
      "title_zh": "① 只有複數形的衣物清單，以及它們配 are 不配 is",
      "explain_zh": "只有複數形的名詞（例如鞋子、襪子、靴子、眼鏡）永遠當複數使用，因此搭配動詞 are，不能用 is。",
      "table": [
        [
          "英文單詞",
          "中文",
          "是否用 are"
        ],
        [
          "shoes",
          "鞋子",
          "Yes"
        ],
        [
          "socks",
          "襪子",
          "Yes"
        ],
        [
          "boots",
          "靴子",
          "Yes"
        ],
        [
          "glasses",
          "眼鏡",
          "Yes"
        ]
      ]
    },
    {
      "title_zh": "② a pair of 的用法與複數 pairs",
      "explain_zh": "用 a pair of 表示一雙，後面接只有複數形的名詞；若要數多雙，用數字 + pairs of + 複數名詞。",
      "examples": [
        {
          "en": "a pair of shoes",
          "zh": "一雙鞋子"
        },
        {
          "en": "two pairs of socks",
          "zh": "兩雙襪子"
        },
        {
          "en": "My glasses are new.",
          "zh": "我的眼鏡是新的。"
        }
      ]
    }
  ],
