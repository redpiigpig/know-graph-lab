  "grammar_points": [
    {
      "title_zh": "① do not / does not 的選擇與縮寫",
      "explain_zh": "主語為第三人稱單數（he/she/it）時使用 does not，其餘主語使用 do not；可縮寫為 doesn't / don't。",
      "table": [
        [
          "主語類型",
          "完整形式",
          "縮寫"
        ],
        [
          "I / you / we / they",
          "do not",
          "don't"
        ],
        [
          "he / she / it",
          "does not",
          "doesn't"
        ]
      ]
    },
    {
      "title_zh": "② does not 後動詞要回到原形",
      "explain_zh": "在 does not 後面，主要動詞必須使用原形，不能加 -s 或 -ed。",
      "examples": [
        {
          "en": "A shark does not fly.",
          "zh": "鯊魚不會飛。"
        },
        {
          "en": "Owls do not sleep at night.",
          "zh": "貓頭鷹不會在晚上睡覺。"
        }
      ]
    }
  ],
