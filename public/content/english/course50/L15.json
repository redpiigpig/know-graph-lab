  "grammar_points": [
    {
      "title_zh": "① There is / There are 的基本用法",
      "explain_zh": "用來說明某件事物的存在。單數名詞用 There is，複數名詞用 There are。",
      "table": [
        [
          "主語數量",
          "動詞形式",
          "例句英文",
          "例句中文"
        ],
        [
          "單數名詞",
          "There is",
          "There is a dog.",
          "有一隻狗。"
        ],
        [
          "複數名詞",
          "There are",
          "There are dogs.",
          "有狗。"
        ],
        [
          "未指定數量",
          "There are",
          "There are some birds.",
          "有一些鳥。"
        ],
        [
          "零數量",
          "There are",
          "There are no cats.",
          "沒有貓。"
        ]
      ]
    },
    {
      "title_zh": "② 複數名詞的變化規則",
      "explain_zh": "大多數名詞直接加 -s；以 s, x, z, ch, sh 結尾加 -es；以 y 結尾且前面為子音時，改 y 為 i 再加 -es；有些名詞有不規則變化。",
      "examples": [
        {
          "en": "fox -> foxes",
          "zh": "狐狸 -> 狐狸們"
        },
        {
          "en": "giraffe -> giraffes",
          "zh": "長頸鹿 -> 長頸鹿們"
        },
        {
          "en": "butterfly -> butterflies",
          "zh": "蝴蝶 -> 蝴蝶們"
        },
        {
          "en": "ant -> ants",
          "zh": "螞蟻 -> 螞蟻們"
        },
        {
          "en": "spider -> spiders",
          "zh": "蜘蛛 -> 蜘蛛們"
        }
      ]
    }
  ],
