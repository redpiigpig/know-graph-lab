  "grammar_points": [
    {
      "title_zh": "① 可數名詞與 I like… / Do you like…?",
      "explain_zh": "說明如何用 I like… 和 Do you like…? 談論可數名詞，單數用 a/an，複數直接用複數形。",
      "table": [
        [
          "名詞",
          "單數形",
