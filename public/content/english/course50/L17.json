  "grammar_points": [
    {
      "title_zh": "① Do／Does + 主詞 + 動詞原形 的語序",
      "explain_zh": "在一般現在時的疑問句，用 Do 或 Does 放在句首，主詞放在後面，動詞用原形。第三人稱單數 (he/she/it) 用 Does，其餘主詞用 Do。",
      "table": [
        [
          "主詞",
          "助動詞",
          "動詞原形",
          "完整疑問句"
        ],
        [
          "I",
          "Do",
          "like",
          "Do you like cheese?"
        ],
        [
          "you",
          "Do",
          "like",
          "Do you like cheese?"
        ],
        [
          "we",
          "Do",
          "like",
          "Do we like cheese?"
        ],
        [
          "they",
          "Do",
          "like",
          "Do they like cheese?"
        ],
        [
          "he",
          "Does",
          "like",
          "Does he like cheese?"
        ],
        [
          "she",
          "Does",
          "like",
          "Does she like cheese?"
        ],
        [
          "it",
          "Does",
          "like",
          "Does it like cheese?"
        ]
      ]
    },
    {
      "title_zh": "② 簡答要跟著問句用 do／does，不可用 be 動詞",
      "explain_zh": "回答 Yes/No 時，助動詞要和問句中的 Do/Does 一致，不能用 am/is/are。正面回答用 Yes, I/you/we/they/he/she/it do. 或 Does.；負面回答用 No, I/you/we/they/he/she/it don't. 或 doesn't.",
      "examples": [
        {
          "en": "Do you like cheese? → Yes, I do.",
          "zh": "你喜歡起士嗎？→是的，我喜歡。"
        },
        {
          "en": "Does she cook? → No, she doesn't.",
          "zh": "她會煮飯嗎？→不，她不會。"
        }
      ]
    }
  ],
