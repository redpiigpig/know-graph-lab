        [
          "egg",
          "an egg",
          "eggs"
        ],
        [
          "snack",
          "a snack",
          "snacks"
        ],
        [
          "cake",
          "a cake",
          "cakes"
        ],
        [
          "candy",
          "a candy",
          "candies"
        ],
        [
          "cookie",
          "a cookie",
          "cookies"
        ],
        [
          "vegetable",
          "a vegetable",
          "vegetables"
        ]
      ]
    },
    {
      "title_zh": "② 不可數名詞與 I like… / Do you like…?",
      "explain_zh": "說明如何用 I like… 和 Do you like…? 談論不可數名詞，不加 a/an，複數形不變，可用 some/any 來表示量。",
      "examples": [
        {
          "en": "I like cheese.",
          "zh": "我喜歡起士。"
        },
        {
          "en": "Do you like sugar?",
          "zh": "你喜歡糖嗎？"
        },
        {
          "en": "I like some soup.",
          "zh": "我喜歡一些湯。"
        },
        {
          "en": "Do you like any oil?",
          "zh": "你喜歡任何油嗎？"
        },
        {
          "en": "I like chocolate.",
          "zh": "我喜歡巧克力。"
        }
      ]
    }
  ],
