  "grammar_points": [
    {
      "title_zh": "① How much is／are 隨東西的單複數變化",
      "explain_zh": "根據名詞是單數還是複數選擇 is 或 are 來問價錢，回答一律用 It is … dollars。",
      "table": [
        [
          "名詞",
          "疑問句",
          "回答"
        ],
        [
          "congee (單數)",
          "How much is the congee?",
          "It is thirty dollars."
        ],
        [
          "meatballs (複數)",
          "How much are the meatballs?",
          "It is twenty dollars."
        ]
      ]
    },
    {
      "title_zh": "② How much（不可數、價錢）與 How many（可數）的分工",
      "explain_zh": "How much 用來詢問不可數名詞的價格或數量；How many 用來詢問可數名詞的數量。",
