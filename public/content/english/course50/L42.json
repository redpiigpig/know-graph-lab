{
  "title_en": "A Day in the Park",
  "title_zh": "公園裡的一天",
  "grammar": "本課學習使用 can / can't 表達能力，並練習動作動詞與方向介系詞。",
  "intro_zh": "在這一課，我們將學習用 可以 和 不能 說出自己能做什麼、不能做什麼，同時練習動作詞和方向詞，例如來、去、推、拉、放、沿著、繞著、往上、往下、左邊、右邊，讓描述日常活動更清楚。",
  "can_do": [
    "能用 can/can't 說出自己的能力",
    "能正確使用動作動詞與方向介系詞描述行動",
    "能閱讀簡短故事並回答相關問題"
  ],
  "reading": {
    "title_en": "A Day in the Park",
    "title_zh": "公園裡的一天",
    "sentences": [
      {
        "en": "We come to the park and go along the path.",
        "zh": "我們來到公園，並沿著小路走去。"
      },
      {
        "en": "We follow the signs and cross the small bridge.",
        "zh": "我們跟隨指示牌，越過小橋。"
      },
      {
        "en": "We move the picnic table into the shade near the front.",
        "zh": "我們把野餐桌移到前面的陰涼處。"
      },
      {
        "en": "I push the chair to the left side of the table.",
        "zh": "我把椅子推到桌子左邊。"
      },
      {
        "en": "My friend pulls the wagon from the back to the right.",
        "zh": "我的朋友把手推車從後面拉到右邊。"
      },
      {
        "en": "We put the blanket on the ground and sit down.",
        "zh": "我們把毯子鋪在地上，然後坐下。"
      },
      {
        "en": "Then we climb up the hill to look around.",
        "zh": "然後我們爬上小山，四處看看。"
      },
      {
        "en": "We can see the lake over the trees and watch the ducks swim out.",
        "zh": "我們可以看到樹林彼端的湖泊，並看見鴨子游出來。"
      },
      {
        "en": "When it's time to leave, we pack everything and go back home.",
        "zh": "該離開時，我們收拾東西，然後回家。"
      }
    ]
  },
  "grammar_points": [
    {
      "title_zh": "① can / can't + 動詞 + 方向介系詞",
      "explain_zh": "學習用 can / can't 表達自己能或不能做某個帶有方向的動作。動詞後面直接接方向介系詞，構成「動詞+方向」的片語。",
      "table": [
        [
          "主語",
          "can / can't",
          "動詞+方向",
          "中文意思"
        ],
        [
          "I",
          "can",
          "go up",
          "我可以往上走"
        ],
        [
          "I",
          "can't",
          "go down",
          "我不能往下走"
        ],
        [
          "She",
          "can",
          "come along",
          "她可以沿著來"
        ],
        [
          "He",
          "can't",
          "cross over",
          "他不能越過"
        ],
        [
          "We",
          "can",
          "move left",
          "我們可以向左移動"
        ],
        [
          "They",
          "can't",
          "push right",
          "他們不能往右推"
        ]
      ]
    },
    {
      "title_zh": "② 詢問與回答能力（Can you ...？）",
      "explain_zh": "用 Can you + 動詞+方向？來詢問對方的能力，回答用 Yes, I can. 或 No, I can't.。",
      "examples": [
        {
          "en": "Can you go along the hallway?",
          "zh": "你能沿著走廊走嗎？"
        },
        {
          "en": "Can't you pull the door out?",
          "zh": "你不能把門拉出來嗎？"
        },
        {
          "en": "Can she follow the teacher around the classroom?",
          "zh": "她能跟著老師在教室裡繞行嗎？"
        },
        {
          "en": "Can't they put the book back into the bag?",
          "zh": "他們不能把書放回袋子裡嗎？"
        }
      ]
    }
  ],
