  "grammar_points": [
    {
      "title_zh": "① have／has 隨主詞變化的對照表",
      "explain_zh": "主詞不同，have 或 has 的形式會變化。I、you、we、they 用 have；he、she、it 用 has。",
      "table": [
        [
          "主詞",
          "have/has",
          "例句"
        ],
        [
          "I",
          "have",
          "I have two arms."
        ],
        [
          "you",
          "have",
          "You have ten fingers."
        ],
        [
          "we",
          "have",
          "We have healthy hearts."
        ],
        [
          "they",
          "have",
          "They have strong legs."
        ],
        [
          "he",
          "has",
          "He has short hair."
        ],
        [
          "she",
          "has",
          "She has a big smile."
        ],
        [
          "it",
          "has",
          "The robot has shiny eyes."
        ]
      ]
    },
    {
      "title_zh": "② I have…／She has… 描述身體與擁有物",
      "explain_zh": "用 I have… 描述自己身體或擁有的東西；用 She has… 描述女生的身體特徵或物品。",
      "examples": [
        {
          "en": "I have two eyes and a nose.",
          "zh": "我有兩隻眼睛和一個鼻子。"
        },
