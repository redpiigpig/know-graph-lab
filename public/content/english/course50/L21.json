  "grammar_points": [
    {
      "title_zh": "① There is / There are 的基本用法",
      "explain_zh": "用來說明教室裡有什麼東西，單數用 is，複數用 are。否定句在 is/are 後加 not，疑問句則把 is/are 放在句首。",
      "table": [
        [
          "句型",
          "說明",
          "例句"
        ],
        [
          "There is + 單數名詞",
          "表示單數存在",
          "There is a blackboard in the classroom."
        ],
        [
          "There are + 複數名詞",
          "表示複數存在",
          "There are many students in the classroom."
        ],
        [
          "Is there + 單數名詞 + ?",
          "詢問單數是否存在",
          "Is there a ruler on the desk?"
        ],
        [
          "Are there + 複數名詞 + ?",
          "詢問複數是否存在",
          "Are there any erasers under the chair?"
        ]
      ]
    },
    {
      "title_zh": "② 介系詞 in、on、under 的用法",
      "explain_zh": "用來表示物體位置的關係。in 表示在…內部，on 表示在…表面，under 表示在…下方。",
      "examples": [
        {
          "en": "The pencil is in the bag.",
          "zh": "鉛筆在書包裡。"
        },
        {
          "en": "The chalk is on the blackboard.",
          "zh": "粉筆在黑板上。"
        },
        {
          "en": "The eraser is under the desk.",
          "zh": "橡皮擦在桌子底下。"
        },
        {
          "en": "The bell is on the wall.",
          "zh": "鐘在牆上。"
        },
        {
          "en": "The ruler is in the pencil case.",
          "zh": "尺在筆盒裡。"
        }
      ]
    }
  ],
