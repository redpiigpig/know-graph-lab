  "grammar_points": [
    {
      "title_zh": "① 指示詞的遠近與單複數對照表",
      "explain_zh": "這裡說明 this/that 用於單數，these/those 用於複數；近的用 this/these，遠的用 that/those。",
      "table": [
        [
          "距離",
          "單數",
          "複數"
        ],
        [
          "近的",
          "this",
          "these"
        ],
        [
          "遠的",
          "that",
          "those"
        ]
      ]
    },
    {
      "title_zh": "② These／Those 後面的 be 動詞要用 are、名詞要用複數",
      "explain_zh": "當使用 These 或 Those 時，表示多於一個，所以 be 動詞用 are，後面的名詞必須是複數形。",
