{
  "title_en": "Hello & Me",
  "title_zh": "問候與自我介紹",
  "grammar": "練習使用 be 動詞 (am/is/are) 與主詞代名詞 I, you, he, she, it, we, they 來說 I am…、You are…。",
  "intro_zh": "本課將學習用 be 動詞進行問候與自我介紹，練習說出名字、年齡、家鄉等資訊，並以友善方式認識新朋友。此外，我們會學習使用數字一到十描述禮物數量，以及眨眼、悄悄說等動詞表達細膩動作。",
  "can_do": [
    "能使用 am/is/are 正確說出 I am…、You are…。",
    "能以完整句子進行簡單的問候與自我介紹。",
    "能使用數字一到十及 wink、whisper 等詞彙描述日常情境。"
  ],
  "reading": {
    "title_en": "A Friendly Day",
    "title_zh": "友好的一天",
    "sentences": [
      {
        "en": "Hello! I am Mei, and this is my neighbor, Mr. Lin.",
        "zh": "嗨！我是 Mei，這是我的鄰居林先生。"
      },
      {
        "en": "We give a warm greeting when we meet.",
        "zh": "我們見面時會給予熱情的問候。"
      },
      {
        "en": "Mr. Lin likes to wink when he tells a secret.",
        "zh": "林先生喜歡在告訴秘密時眨眼。"
      },
      {
        "en": "Sometimes he whispers the secret to me.",
        "zh": "有時他會悄悄地把秘密告訴我。"
      },
      {
        "en": "I introduce myself with my nickname, ‘Little Star’.",
        "zh": "我以我的綽號『小星星』介紹自己。"
      },
      {
        "en": "My birthday is in May, and I am seven years old.",
        "zh": "我的生日在五月，我今年七歲。"
      },
      {
        "en": "My hometown is Taichung, a beautiful city in central Taiwan.",
        "zh": "我的家鄉是台中，一座位於台灣中部的美麗城市。"
      },
      {
        "en": "Today we have three guests: a lady, a boy, and a girl.",
        "zh": "今天我們有三位客人：一位女士、一位男孩和一位女孩。"
      },
      {
        "en": "They bring gifts numbered from one to ten for our game.",
        "zh": "他們帶來從一到十編號的禮物，供我們玩遊戲。"
      }
    ]
  },
