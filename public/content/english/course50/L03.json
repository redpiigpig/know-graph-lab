    "能在自我介紹中使用 greeting、nickname、birthday 等詞彙"
  ],
  "reading": {
    "title_en": "Meet Mei",
    "title_zh": "見面自我介紹",
    "sentences": [
      {
        "en": "This is a friendly greeting when I meet my neighbor.",
        "zh": "這是我遇到鄰居時會用的友善問候。"
      },
      {
        "en": "Today I will introduce my new neighbor, Mr. Lin.",
        "zh": "今天我要介紹我的新鄰居林先生。"
      },
      {
        "en": "He is not a guest; he is my neighbor.",
        "zh": "他不是客人，他是我的鄰居。"
      },
      {
        "en": "Is he your neighbor? Yes, he is.",
        "zh": "他是你的鄰居嗎？是的，他是。"
      },
      {
        "en": "We shake hands and give a thumbs up.",
        "zh": "我們握手並比讚。"
      },
      {
        "en": "He whispers his nickname to me.",
        "zh": "他悄悄說出他的綽號給我聽。"
      },
      {
        "en": "My nickname is 'Lucky', and my birthday is on May fifth.",
        "zh": "我的綽號是『Lucky』，我的生日是五月五日。"
      },
      {
        "en": "His hometown is Kaohsiung, and he is seven years old.",
        "zh": "他的家鄉是高雄，他七歲。"
      },
      {
        "en": "We count together: one, two, three, four, five, six, seven, eight, nine, ten.",
        "zh": "我們一起數數：一、二、三、四、五、六、七、八、九、十。"
      }
    ]
  },
  "grammar_points": [
    {
      "title_zh": "① be 動詞的否定與縮寫",
      "explain_zh": "否定詞 not 放在 be 動詞後面，可縮寫為 isn't 或 aren't。",
      "table": [
        [
          "主詞",
          "be 動詞 + not",
          "縮寫形式"
        ],
        [
          "I",
          "am not",
          "I'm not"
        ],
        [
          "He",
          "is not",
          "He isn't"
        ],
        [
          "She",
          "is not",
          "She isn't"
        ],
        [
          "It",
          "is not",
          "It isn't"
        ],
        [
          "You",
          "are not",
          "You aren't"
        ],
        [
          "We",
          "are not",
          "We aren't"
        ],
        [
          "They",
          "are not",
          "They aren't"
        ]
      ]
    },
    {
      "title_zh": "② Yes/No 問答的完整簡答",
      "explain_zh": "簡答必須保留主詞，不能省略，例如 Yes, I am. 或 No, she is not.。",
      "examples": [
        {
          "en": "Yes, I am.",
          "zh": "是的，我是。"
        },
        {
          "en": "No, he is not.",
          "zh": "不是，他不是。"
        },
        {
          "en": "Yes, they are.",
          "zh": "是的，他們是。"
        }
      ]
    }
  ],
