  "grammar_points": [
    {
      "title_zh": "① 頻率副詞的大小與位置",
      "explain_zh": "頻率副詞表示動作發生的頻率，依照從高到低排序為：always（總是）、often（時常）、sometimes（有時）、seldom（很少）、never（從不）。當句子的動詞是一般動詞時，頻率副詞放在動詞前面；當動詞是 be 動詞時，頻率副詞放在 be 動詞後面。",
      "table": [
        [
          "頻率副詞",
          "意思",
          "放置位置"
        ],
        [
          "always",
          "總是",
          "一般動詞前 / be 動詞後"
        ],
        [
          "often",
          "時常",
          "一般動詞前 / be 動詞後"
        ],
        [
          "sometimes",
          "有時",
          "一般動詞前 / be 動詞後"
        ],
        [
          "seldom",
          "很少",
          "一般動詞前 / be 動詞後"
        ],
        [
          "never",
          "從不",
          "一般動詞前 / be 動詞後"
        ]
      ]
    },
    {
      "title_zh": "② 時間副詞 then、soon、early、late 的位置",
      "explain_zh": "時間副詞 then（當時）、soon（不久）、early（早）、late（晚）通常放在句子的結尾，用來說明動作發生的時間。",
      "examples": [
        {
          "en": "I finished my homework early.",
          "zh": "我早早完成功課。"
        },
        {
          "en": "She will come soon.",
          "zh": "她不久會來。"
        },
        {
          "en": "We met then.",
          "zh": "我們當時見面了。"
        },
        {
          "en": "He arrives late.",
          "zh": "他遲到。"
        }
      ]
    }
  ],
