  "grammar_points": [
    {
      "title_zh": "① -ing 的拼字規則",
      "explain_zh": "當動詞加 -ing 時，需注意兩種拼寫變化：1) 如果動詞以無聲的 e 結尾，去掉 e 再加 -ing；2) 如果動詞是重音閉音節且以單一子音結尾，則重複該子音再加 -ing。以下表格列出常見例子。",
      "table": [
        [
          "原形",
          "去 e",
          "重複字尾子音",
          "-ing 形"
        ],
        [
          "make",
          "make",
          "",
          "making"
        ],
        [
          "write",
          "write",
          "",
          "writing"
        ],
        [
          "run",
          "run",
          "r",
          "running"
        ],
        [
          "begin",
          "begin",
          "n",
          "beginning"
        ]
      ]
    },
    {
      "title_zh": "② 現在進行式（正在做）與現在簡單式（習慣）的差別",
      "explain_zh": "現在進行式用 be 動詞 + 動詞 -ing，表示話語時刻正在發生的動作。現在簡單式用動詞原形（三人稱單數加 -s），表示習慣、經常發生或事實。以下例句說明兩者的意思差異。",
      "examples": [
        {
          "en": "She is reading a story.",
          "zh": "她正在閱讀一個故事。"
        },
        {
          "en": "They are studying English.",
          "zh": "他們正在學習英語。"
        }
      ]
    }
  ],
