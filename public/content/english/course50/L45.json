        [
          "I",
          "want to be",
          "I want to be a teacher."
        ],
        [
          "You",
          "want to be",
          "You want to be a doctor."
        ],
        [
          "He/She/It",
          "wants to be",
          "He wants to be a soldier."
        ],
        [
          "We",
          "want to be",
          "We want to be artists."
        ],
        [
          "They",
          "want to be",
          "They want to be scientists."
