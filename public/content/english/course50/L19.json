  "grammar_points": [
    {
      "title_zh": "① Would you like…? 比 Do you want…? 客氣的差別",
      "explain_zh": "說明 Would you like…? 比 Do you want…? 更客氣，適合在詢問對方意願時使用，而 Do you want…? 較直接，可能顯得不禮貌。",
      "table": [
        [
          "句型",
          "語氣",
          "例句"
        ],
        [
          "Would you like some tea?",
          "較客氣、詢問對方意願",
          "Would you like some tea?"
        ],
        [
          "Do you want some tea?",
          "較直接、可能顯得不禮貌",
          "Do you want some tea?"
        ]
      ]
    },
    {
      "title_zh": "② I'd like 的用法",
      "explain_zh": "I'd like 是 I would like 的縮寫，後面可以接名詞表示想要某物，也可以接 to + 動詞表示想要做某事。",
      "examples": [
        {
          "en": "I'd like a cup of tea.",
          "zh": "我想要一杯茶。"
        },
        {
          "en": "I'd like to eat some mango.",
          "zh": "我想吃一些芒果。"
        }
      ]
    }
  ],
