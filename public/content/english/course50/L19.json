  "grammar_points": [
    {
      "title_zh": "① Would you like…?",
      "explain_zh": "用來詢問對方是否想要某物，後面接名詞或動詞原形。常見的回答有 Yes, please. 或 No, thank you.",
      "table": [
        [
          "主語",
          "Would you like + 名詞？",
          "可能的回答"
        ],
        [
          "你",
          "Would you like an apple?",
          "Yes, please. / No, thank you."
        ],
        [
          "媽媽",
          "Would you like some water?",
          "Sure. / I’m fine."
        ],
        [
          "朋友",
          "Would you like to try this guava?",
          "Sounds good! / Not now, thanks."
        ]
      ]
    },
    {
      "title_zh": "② How much…?",
      "explain_zh": "用來詢問不可數名詞的數量或價格，後面接不可數名詞（如 water、juice）或直接問價格。",
      "examples": [
        {
          "en": "How much water do you want?",
          "zh": "你想要多少水？"
        },
        {
          "en": "How much is this watermelon?",
          "zh": "這個西瓜多少錢？"
        },
        {
          "en": "How much juice did you drink?",
          "zh": "你喝了多少果汁？"
        },
        {
          "en": "How much does a bowl of oyster omelet cost?",
          "zh": "一碗蚵仔煎要多少錢？"
        }
      ]
    }
  ],
