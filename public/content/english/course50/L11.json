  "grammar_points": [
    {
      "title_zh": "① 動詞加 -s、-es、-ies 的拼寫規則",
      "explain_zh": "說明當主詞是 he、she、it 或單數名詞時，一般動詞要加 -s。若動詞以 -s、-sh、-ch、-x、-o 結尾，加 -es；若以輔音 + y 結尾，先改 y 為 i 再加 -es。",
      "table": [
        [
          "原形動詞",
          "結尾",
          "變化規則",
          "三單形式"
        ],
        [
          "care",
          "e",
          "加 -s",
          "cares"
        ],
        [
          "kiss",
          "ss",
          "加 -es",
          "kisses"
        ],
        [
          "try",
          "y (前為輔音)",
          "改 y 為 i 再加 -es",
          "tries"
        ]
      ]
    },
    {
      "title_zh": "② 以家人為主詞練習三單動詞",
      "explain_zh": "讓學生以家庭成員作主詞，練習動詞加 -s/-es。",
