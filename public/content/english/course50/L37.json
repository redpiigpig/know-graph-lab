  "grammar_points": [
    {
      "title_zh": "① 常接 to + 原形的動詞清單",
      "explain_zh": "英文中有一些動詞，後面必須接 to + 動詞原形。這些動詞常常表示心情、想法或計畫。想想看，你想做什麼事？你希望什麼？你需要什麼？就用這些動詞加上 to + 動詞原形來表達。",
      "table": [
        [
          "動詞",
          "中文意思",
          "例句"
        ],
        [
          "want",
          "想要",
          "I want to play."
        ],
        [
          "hope",
          "希望",
          "She hopes to win."
        ],
        [
          "need",
          "需要",
          "We need to study."
        ],
        [
          "decide",
          "決定",
          "He decides to try."
        ],
        [
          "try",
          "嘗試",
          "They try to help."
        ],
        [
          "wish",
          "希望",
          "I wish to visit."
        ],
        [
          "dream",
          "夢想",
          "She dreams to fly."
        ],
        [
          "agree",
          "同意",
          "We agree to go."
        ]
      ]
    },
    {
      "title_zh": "② to 後面一定是動詞原形（不加 s，不加 ing）",
      "explain_zh": "記住！to 後面的動詞一定要用「原形」。不能寫 to enjoys（加 s 錯誤），也不能寫 to enjoying（加 ing 錯誤）。一定是 to enjoy。就像一個規則：to 後面永遠是乾乾淨淨的動詞原形。",
      "examples": [
        {
          "en": "She wants to dance.",
          "zh": "她想要跳舞。（to dance 是原形，不是 to dances 或 to dancing）"
        },
        {
          "en": "I hope to meet you.",
          "zh": "我希望見到你。（to meet 是原形）"
        },
        {
          "en": "We need to sleep.",
          "zh": "我們需要睡覺。（to sleep 是原形，不是 to sleeps）"
        },
        {
          "en": "They decide to eat lunch.",
          "zh": "他們決定吃午餐。（to eat 是原形）"
        },
        {
          "en": "He tries to understand.",
          "zh": "他嘗試理解。（to understand 是原形，不是 to understands）"
        }
      ]
    }
  ],
