  "grammar_points": [
    {
      "title_zh": "① 形容詞 vs 副詞的位置差別",
      "explain_zh": "形容詞放在名詞前或be動詞後，用來修飾名詞；副詞放在動詞後，用來修飾動作。",
      "table": [
        [
          "詞類",
          "位置",
          "功能",
          "例句"
        ],
        [
          "形容詞",
          "名詞前 / be 動詞後",
          "修飾名詞",
          "He is a fast runner."
        ],
        [
          "副詞",
          "動詞後",
          "修飾動詞",
          "He runs fast."
        ]
      ]
    },
    {
      "title_zh": "② 副詞加 -ly 的規則，以及 fast／loud／well 這幾個要背",
      "explain_zh": "大多數副詞在形容詞後加 -ly 形成；但 fast、loud 形副同形；well 是 good 的副詞。",
