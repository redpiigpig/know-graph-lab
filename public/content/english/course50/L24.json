  "grammar_points": [
    {
      "title_zh": "① 主格與受格對照表",
      "explain_zh": "主格用於句子的主語，受格用於動詞或介系詞的受詞。以下表格列出人稱代名詞的主格與受格對應。",
      "table": [
        [
          "人稱",
          "主格",
          "受格"
        ],
        [
          "我",
          "I",
          "me"
        ],
        [
          "你",
          "you",
          "you"
        ],
        [
          "他",
          "he",
          "him"
        ],
        [
          "她",
          "she",
          "her"
        ],
        [
          "它",
          "it",
          "it"
        ],
        [
          "我們",
          "we",
          "us"
        ],
        [
          "他們／她們",
          "they",
          "them"
        ]
      ]
    },
    {
      "title_zh": "② 動詞或介系詞後面要用受格",
      "explain_zh": "在動詞直接受詞或介系詞的賓語位置，必須使用受格代名詞（me、you、him、her、it、us、them），不能使用主格。",
