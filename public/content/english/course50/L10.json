  "grammar_points": [
    {
      "title_zh": "① 主詞 + 動詞原形 + 受詞 的基本語序",
      "explain_zh": "在現在簡單式中，當主詞是 I、you、we、they 時，動詞使用原形，後面直接接受詞，形成 S+V+O 的句子。",
      "table": [
        [
          "主詞",
          "動詞原形",
          "受詞",
          "完整句子"
        ],
        [
          "I",
          "open",
          "the window",
          "I open the window."
        ],
        [
          "You",
          "give",
          "me a gift",
          "You give me a gift."
        ],
        [
          "We",
          "help",
          "the students",
          "We help the students."
        ],
        [
          "They",
          "start",
          "the game",
          "They start the game."
        ]
      ]
    },
    {
      "title_zh": "② 一般動詞句和 be 動詞句不可以混用",
      "explain_zh": "現在簡單式的一般動詞句只能用動詞原形，不能在動詞前加 be 動詞 (am/is/are)，否則會變成錯誤句子。",
      "examples": [
        {
          "en": "I think about the answer.",
          "zh": "我思考答案。"
        },
        {
          "en": "You point at the picture.",
          "zh": "你指著圖片。"
        },
        {
          "en": "We brush our teeth every night.",
          "zh": "我們每晚刷牙。"
        },
        {
          "en": "They close the gate after school.",
          "zh": "他們放學後關上大門。"
        },
        {
          "en": "I am think about the answer.",
          "zh": "我是思考答案。（錯誤）"
        },
        {
          "en": "You are point at the picture.",
          "zh": "你是指著圖片。（錯誤）"
        },
        {
          "en": "We are brush our teeth every night.",
          "zh": "我們是每晚刷牙。（錯誤）"
        },
        {
          "en": "They are close the gate after school.",
          "zh": "他們是放學後關上大門。（錯誤）"
        }
      ]
    }
  ],
