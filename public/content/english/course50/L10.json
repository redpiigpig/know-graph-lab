  "grammar_points": [
    {
      "title_zh": "① I have / He has 描述身體部位",
      "explain_zh": "用 I have (for I) 或 He has (for he/she) 後面接名詞來說明自己或他人的身體部位。",
      "table": [
        [
          "Subject",
          "Verb",
          "Body Part",
          "Example Sentence"
        ],
        [
          "I",
          "have",
          "eyes",
          "I have two eyes."
        ],
        [
          "He",
          "has",
          "ears",
          "He has big ears."
        ],
        [
          "She",
          "has",
          "mouth",
          "She has a small mouth."
        ]
      ]
    },
    {
      "title_zh": "② I have / He has 描述能力或特徵",
      "explain_zh": "同樣結構可以用來說明某人擁有的能力或特徵，例如聲音、笑聲等。",
      "examples": [
        {
          "en": "I have a clear voice when I sing.",
          "zh": "我唱歌時聲音很清楚。"
        },
        {
          "en": "He has a loud laugh that makes everyone smile.",
          "zh": "他的笑聲很大聲，讓大家都笑起來。"
        },
        {
          "en": "She has quick hands and can pick up toys fast.",
          "zh": "她手腳很快，能快速拿起玩具。"
        }
      ]
    }
  ],
