  "grammar_points": [
    {
      "title_zh": "① I like… 與可數/不可數名詞的搭配",
      "explain_zh": "當我們用 I like... 來說喜歡的食物時，可數名詞要視單數或複數加上 a/an 或直接使用複數形；不可數名詞則可以直接說，或加上 some 來表示「一些」。",
      "table": [
        [
          "名詞類型",
          "例句 (I like...)",
          "說明"
        ],
        [
          "可數單數",
          "I like an apple.",
          "單數可數名詞前加 a/an"
        ],
        [
          "可數複數",
          "I like apples.",
          "複數形直接使用，不加冠詞"
        ],
        [
          "不可數",
          "I like water.",
          "不可數名詞直接使用"
        ],
        [
          "不可數 (加 some)",
          "I like some juice.",
          "加 some 表示「一些」"
        ]
      ]
    },
    {
      "title_zh": "② Do you like…? 的問句與可數/不可數名詞",
      "explain_zh": "用 Do you like...? 詢問對方喜好時，可數單數需加 a/an，可數複數直接用複數形，不可數名詞可以直接說或加 some。",
      "examples": [
        {
          "en": "Do you like a sandwich?",
          "zh": "你喜歡三明治嗎？"
        },
        {
          "en": "Do you like bananas?",
          "zh": "你喜歡香蕉嗎？"
        },
        {
          "en": "Do you like milk?",
          "zh": "你喜歡牛奶嗎？"
        },
        {
          "en": "Do you like some tea?",
          "zh": "你喜歡一些茶嗎？"
        }
      ]
    }
  ],
