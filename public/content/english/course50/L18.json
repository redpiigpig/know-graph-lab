  "grammar_points": [
    {
      "title_zh": "① 常見量詞對照表",
      "explain_zh": "不可數的東西（像水、牛奶、果汁）無法直接用一、二來數，必須用容器或單位來量，例如 glass（玻璃杯）、bottle（瓶子）、cup（茶杯）、piece（塊）、bowl（碗）。量詞放在名詞前面，構成「量詞 + of + 名詞」的結構。",
      "table": [
        [
          "量詞",
          "名詞（不可數）",
          "例句"
        ],
        [
          "glass",
          "water",
          "a glass of water"
        ],
        [
          "bottle",
          "milk",
          "a bottle of milk"
        ],
        [
          "cup",
          "juice",
          "a cup of juice"
        ],
        [
          "cup",
          "coffee",
          "a cup of coffee"
        ],
        [
          "piece",
          "cake",
          "a piece of cake"
        ],
        [
          "bowl",
          "soup",
          "a bowl of soup"
        ]
      ]
    },
    {
      "title_zh": "② 量詞變複數時的規則",
      "explain_zh": "當我們要說多於一個容器時，只在量詞後面加 -s，名詞本身保持單數形（仍用 of + 名詞）。例如兩杯水是 two glasses of water，而不是 two glass of waters。",
      "examples": [
        {
          "en": "Two glasses of water.",
          "zh": "兩杯水。"
        },
        {
          "en": "Three bottles of coke.",
          "zh": "三瓶可口可樂。"
        },
        {
          "en": "Four pieces of cake.",
          "zh": "四塊蛋糕。"
        }
      ]
    }
  ],
