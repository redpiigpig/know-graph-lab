  "grammar_points": [
    {
      "title_zh": "① be 動詞的變化：am/is/are 與主詞代名詞對應",
      "explain_zh": "be 動詞會依照主詞代名詞而改變：I 用 am, you 用 are, he/she/it 用 is, we/they 用 are。",
