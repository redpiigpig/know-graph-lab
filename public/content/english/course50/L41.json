{
  "title_en": "I Can Do",
  "title_zh": "我做得到的事",
  "intro_zh": "本課學會使用可以與不能表達能力與不能做的事，練習肯定、否定與問答句型，讓學生能描述自己會做什麼、不會做什麼，並以簡單對話確認。",
  "can_do": [
    "說出自己會做的事",
    "用 can 與 can't 回答是非問題",
    "描述同學的能力與限制"
  ],
  "reading": {
    "title_en": "At the Park",
    "title_zh": "我在公園玩",
    "sentences": [
      {
        "en": "Lily can go to the park.",
        "zh": "莉莉可以去公園。"
      },
      {
        "en": "She can jump and climb.",
        "zh": "她可以跳躍和攀爬。"
      },
      {
        "en": "She can skate but she must not hurt herself.",
        "zh": "她可以滑冰但她不應該受傷。"
      },
      {
        "en": "She can kick a ball, then bring her bag.",
        "zh": "她可以踢球，然後帶著她的背包。"
      },
      {
        "en": "She can hide behind a tree, then collect leaves.",
        "zh": "她可以躲在樹後，然後收集葉子。"
      },
      {
        "en": "She can use a rope to lead her friend.",
        "zh": "她可以用繩子帶領她的朋友。"
      },
      {
        "en": "She can stand and move fast, not slow.",
        "zh": "她可以站立並快速移動，不會慢。"
      },
      {
        "en": "She can bring water and arrive before it gets dark.",
        "zh": "她可以帶水並在天黑前到達。"
      },
      {
        "en": "She can't break the glass or sleep on the bench.",
        "zh": "她不能打破玻璃或在長椅上睡覺。"
      }
    ]
  },
  "grammar_points": [
    {
      "title_zh": "① can + 動詞原形",
      "explain_zh": "can 後面一定接動詞原形，不會隨著主詞的單數或複數而改變。",
      "table": [
        [
          "主詞",
          "can/can't",
          "動詞原形",
          "中文意思"
        ],
        [
          "I",
          "can",
          "climb",
          "我可以爬。"
        ],
        [
          "She",
          "can't",
          "skate",
          "她不能溜冰。"
        ],
        [
          "We",
          "can",
          "jump",
          "我們可以跳。"
        ],
        [
          "They",
          "can't",
          "hurt",
          "他們不會傷害。"
        ]
      ]
    },
    {
      "title_zh": "② Can you…? 的問句與簡答",
      "explain_zh": "把 Can 放在句首構成 yes/no 問句，簡答用 Yes, I can. 或 No, I can't. 主詞會隨著問句的主詞變化（如 Can he…? → Yes, he can.）。",
      "examples": [
        {
          "en": "Can you jump? Yes, I can.",
          "zh": "你能跳嗎？是的，我可以。"
        },
        {
          "en": "Can she go? No, she can't.",
          "zh": "她能去嗎？不能。"
        },
        {
          "en": "Can they skate? Yes, they can.",
          "zh": "他們能溜冰嗎？是的，他們可以。"
        }
      ]
    }
  ],
