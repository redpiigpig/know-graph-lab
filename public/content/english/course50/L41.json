{
  "title_en": "I Can Do It",
  "title_zh": "我可以做到的事",
  "grammar": "本課重點是使用 can 和 can't 描述能力與不能做的事。",
  "intro_zh": "這一課將透過有趣的故事，讓學生學會用 can 和 can't 說出自己會做的事和不會做的事，並練習動作動詞與方向表達，提升日常英語溝通能力。在課堂上透過小組活動和角色扮演，鞏固所學。",
  "can_do": [
    "能用 can/can't 描述自己會做的事和不會做的事",
    "能正確使用動作動詞與方向介詞",
    "能閱讀短文並找出關鍵動詞"
  ],
  "reading": {
    "title_en": "A Busy Day",
    "title_zh": "忙碌的一天",
    "sentences": [
      {
        "en": "Tom can jump high and kick the ball far.",
        "zh": "湯姆能跳得很高，並且能把球踢得很遠。"
      },
      {
        "en": "He likes to use his skateboard to skate around the park.",
        "zh": "他喜歡使用滑板在公園裡溜冰。"
      },
      {
        "en": "Sometimes he hurries to collect sticks and break them for a fort.",
        "zh": "有時他會匆忙去收集樹枝並把它們折斷來建堡壘。"
      },
      {
        "en": "He can climb the small hill and stand on the top to see the view.",
        "zh": "他能爬住小山丘並站在頂端觀賞風景。"
      },
      {
        "en": "When he hides, his friends try to find him before he gets hurt.",
        "zh": "當他躲起來時，他的朋友會在他受傷之前試著找他。"
      },
      {
        "en": "If he falls, he might hit his head and get up quick.",
        "zh": "如果他摔倒，可能會撞到頭然後很快站起來。"
      },
      {
        "en": "He practices every day to sleep better at night.",
        "zh": "他每天練習，以便晚上能睡得更好。"
      },
      {
        "en": "He can lead his team and bring water for everyone when they arrive.",
        "zh": "他能帶領他的隊伍，並在大家到達時帶來水給大家。"
      },
      {
        "en": "He also carries his backpack and walks slow to the playground.",
        "zh": "他也背著背包，慢慢走向操場。"
      }
    ]
  },
  "grammar_points": [
    {
      "title_zh": "① can / can't 的基本用法",
      "explain_zh": "用來說明自己或他人能夠做什麼或不能做什麼。",
      "table": [
        [
          "主語",
          "can / can't",
          "動詞",
          "中文意思"
        ],
        [
          "I",
          "can",
          "jump",
          "我可以跳"
        ],
        [
          "You",
          "can",
          "climb",
          "你可以爬"
        ],
        [
          "He",
          "can't",
          "break",
          "他不能打破"
        ],
        [
          "She",
          "can't",
          "hide",
          "她不能隱藏"
        ],
        [
          "We",
          "can",
          "run",
          "我們可以跑"
        ]
      ]
    },
    {
      "title_zh": "② 用 can / can't 描述方向與動作",
      "explain_zh": "可以加上方向詞（up, down, over, under）或地點來說明能力。",
      "examples": [
        {
          "en": "I can jump over the rope.",
          "zh": "我可以跳過繩子。"
        },
        {
          "en": "She can't crawl under the table.",
          "zh": "她不能爬過桌子底下。"
        },
        {
          "en": "They can climb up the hill.",
          "zh": "他們可以爬上山坡。"
        },
        {
          "en": "He can't skate down the slope.",
          "zh": "他不能溜冰下坡。"
        },
        {
          "en": "We can collect leaves in the garden.",
          "zh": "我們可以在花園裡收集葉子。"
        }
      ]
    }
  ],
