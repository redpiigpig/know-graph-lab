  "grammar_points": [
    {
      "title_zh": "① Where is…? 與 in / on 的復習",
      "explain_zh": "說明如何用 Where is…? 問物品位置，並用 in 表示「在…裡面」，on 表示「在…上面」。",
      "table": [
        [
          "介系詞",
          "意思",
          "例句"
        ],
        [
          "in",
          "在…裡面",
          "The cat is in the box."
        ],
        [
          "on",
          "在…上面",
          "The book is on the table."
        ]
      ]
    },
    {
      "title_zh": "② 新增介系詞 under / near / behind",
      "explain_zh": "學習用 under 表示「在…下面」，near 表示「在…旁邊」，behind 表示「在…後面」。",
      "examples": [
        {
          "en": "The shoe is under the bed.",
          "zh": "鞋子在床下。"
