    "sentences": [
      {
        "en": "I live in Taoyuan, and my address is near a convenient store.",
        "zh": "我住在桃園，我的地址靠近一間便利商店。"
      },
      {
        "en": "Is there a shop close to my house?",
        "zh": "我家附近有商店嗎？"
