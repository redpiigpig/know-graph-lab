{
  "title_en": "My Family and Friends",
  "title_zh": "我的家人與朋友",
  "grammar": "本課學習使用 This is my… 以及所有格 my / your / his / her。",
  "intro_zh": "在這一課裡，我們將學習怎麼用英文介紹家人和朋友，練習說出他們的名字和關係。透過動物園的故事，自然使用 my、your、his、her 等所有格。",
  "can_do": [
    "能用 This is my… 介紹家人或朋友。",
    "能正確使用 my、your、his、her 表示所有格。",
    "能閱讀簡短故事並回答關於人物與動物的問題。"
  ],
  "reading": {
    "title_en": "A Day at the Zoo",
    "title_zh": "動物園的一天",
    "sentences": [
      {
        "en": "This is my friend Lily.",
        "zh": "這是我的朋友 Lily。"
      },
      {
        "en": "She is from America, so she is an American.",
        "zh": "她來自美國，所以她是美國人。"
      },
      {
        "en": "Her cousin is a nephew named Tom.",
        "zh": "她的表弟是一個名叫 Tom 的姪子。"
      },
      {
        "en": "Tom likes animals, especially bears and bees.",
        "zh": "Tom 喜歡動物，特別是熊和蜜蜂。"
      },
      {
        "en": "At the zoo we saw an elephant, a lion, a monkey, a snake and a tiger.",
        "zh": "在動物園裡，我們看到了大象、獅子、猴子、蛇和老虎。"
      },
      {
        "en": "Everyone thought the tiger was scary, but nobody was hurt.",
        "zh": "大家都覺得老虎很可怕，但沒有人受傷。"
      },
      {
        "en": "A stranger asked if we had a pet bird at home.",
        "zh": "一個陌生人問我們家裡有沒有寵物鳥。"
      },
      {
        "en": "Someone said the bird could sing a lovely song.",
        "zh": "有人說這隻鳥能唱出優美的歌聲。"
      },
      {
        "en": "Anyone can hear the bird's sweet voice from far away.",
        "zh": "任何人都能從遠處聽見這鳥甜美的聲音。"
      },
      {
        "en": "A foreigner from China smiled and said she is Chinese.",
        "zh": "一位來自中國的外國人微笑著說她是中國人。"
      }
    ]
  },
  "grammar_points": [
    {
      "title_zh": "① This is my… 的基本結構",
      "explain_zh": "用來介紹自己或他人關係的句型，結構為「This is + 所有格 + 名詞」。",
      "table": [
        [
          "結構",
          "說明",
          "例句"
        ],
        [
          "This is my + 名詞.",
          "表示「這是我的…」。",
          "This is my mother."
        ],
        [
          "This is your + 名詞.",
          "表示「這是你的…」。",
          "This is your father."
        ],
        [
          "This is his/her + 名詞.",
          "表示「這是他的/她的…」。",
          "This is his brother."
        ]
      ]
    },
    {
      "title_zh": "② 所有格 my / your / his / her 的用法",
      "explain_zh": "所有格放在名詞前面，表示擁有或關係，需根據主語的人稱選擇對應的所有格。",
      "examples": [
        {
          "en": "This is my dog.",
          "zh": "這是我的狗。"
        },
        {
          "en": "Is that your book?",
          "zh": "那是你的書嗎？"
        },
        {
          "en": "Her cat is white.",
          "zh": "她的貓是白色的。"
        },
        {
          "en": "His brother likes soccer.",
          "zh": "他的哥哥喜歡足球。"
        }
      ]
    }
  ],
