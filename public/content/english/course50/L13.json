{
  "title_en": "My Family & Friends",
  "title_zh": "家人與朋友",
  "intro_zh": "本課學習不定代名詞 someone、anyone、everyone、nobody 作為主詞時，動詞一律用單數形。透過生活情境，讓學生練習說出『有人在這裡』、『沒有人知道我的名字』等句子，並了解在問句中使用 anyone 的方式。",
  "can_do": [
    "能用 someone / anyone / everyone / nobody 造句並正確使用單數動詞。",
    "能聽懂並回答 Is anyone at home? 類是的/否定問答。",
    "能在短篇故事中辨認不定代名詞的用法。"
  ],
  "reading": {
    "title_en": "A Day at the Park",
    "title_zh": "公園裡的有趣一天",
    "sentences": [
      {
        "en": "Someone is at the park gate.",
        "zh": "有人在公園門口。"
      },
      {
        "en": "Nobody knows my name.",
        "zh": "沒有人知道我的名字。"
      },
      {
