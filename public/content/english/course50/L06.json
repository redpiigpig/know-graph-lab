  "grammar_points": [
    {
      "title_zh": "① 形容詞放在名詞前面與放在 be 動詞後面",
      "explain_zh": "形容詞可以放在名詞前面來直接修飾名詞，例如 a red ribbon；也可以放在 be 動詞後面，例如 The ribbon is red。兩種意思相同，只是詞序不同。",
      "table": [
        [
          "形容詞 + 名詞",
          "名詞 + be + 形容詞",
          "中文說明"
        ],
        [
          "a red ribbon",
          "The ribbon is red.",
          "紅色的緞帶"
        ],
        [
          "a blue brick",
          "The brick is blue.",
          "藍色的磚塊"
        ]
      ]
    },
    {
      "title_zh": "② 詢問顏色的句型 What color is it?",
      "explain_zh": "用 What color is it? 來問某件事物的顏色，回答用 It is + 顏色。",
      "examples": [
        {
          "en": "What color is it? It is red.",
          "zh": "這是什麼顏色？它是紅色。"
        },
        {
          "en": "What color is it? It is yellow.",
          "zh": "這是什麼顏色？它是黃色。"
        },
        {
          "en": "What color is it? It is green.",
          "zh": "這是什麼顏色？它是綠色。"
        }
      ]
    }
