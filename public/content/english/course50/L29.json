  "grammar_points": [
    {
      "title_zh": "① on／in／at 的使用規則",
      "explain_zh": "on 用於星期與具體日期；in 用於早上、下午、晚上、月份與年份；at 用於具體鐘點、中午與午夜。",
      "table": [
        [
          "時間詞類",
          "對應介系詞",
          "範例"
        ],
        [
          "星期",
          "on",
          "on Monday"
        ],
        [
          "日期",
          "on",
          "on May 5"
        ],
        [
          "早上/下午/晚上",
          "in",
          "in the morning"
        ],
        [
          "月份",
          "in",
          "in January"
        ],
        [
          "年份",
          "in",
          "in 2025"
        ],
        [
          "鐘點",
          "at",
          "at 3 o'clock"
        ],
        [
          "中午",
          "at",
          "at noon"
        ],
        [
          "午夜",
          "at",
          "at midnight"
        ]
      ]
    },
    {
      "title_zh": "② at night 與 in the evening 的例外",
      "explain_zh": "雖然晚上通常用 in the evening，但固定表達 at night 表示『在夜晚』，而 in the evening 則指『傍晚時分』。",
      "examples": [
        {
          "en": "We often read stories at night.",
