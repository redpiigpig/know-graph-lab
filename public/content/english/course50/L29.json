        [
          "問句",
          "回答模式",
          "例句"
        ],
        [
          "What time is it?",
          "It is at + 時間.",
          "What time is it? → It is at 3:15."
        ],
        [
          "What time is it now?",
          "It is at + 時間.",
          "What time is it now? → It is at 12:00."
        ]
      ]
    },
    {
      "title_zh": "② 問星期：What day is it? + on + 星期",
      "explain_zh": "用 What day is it? 來問今天是星期幾，回答時用 on + 星期名稱。",
