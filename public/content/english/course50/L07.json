  "grammar_points": [
    {
      "title_zh": "① a/an 的選擇依據發音",
      "explain_zh": "在單數可數名詞前，如果名詞開頭的發音是母音音素，用 an；如果是子音音素，用 a。注意是看發音，不是看拼寫的第一個字母。",
      "table": [
        [
          "單詞",
          "開頭字母",
          "應用 a/an"
        ],
        [
          "apple",
          "a",
          "an apple"
        ],
        [
          "book",
          "b",
          "a book"
        ],
        [
          "hour",
          "h",
          "an hour"
        ],
        [
          "university",
          "u",
          "a university"
        ],
        [
          "elephant",
          "e",
          "an elephant"
        ]
      ]
    },
    {
      "title_zh": "② This is a… / That is an… 句型",
      "explain_zh": "用來指向近處或遠處的單數名詞，主語用 This（近）或 That（遠），後面接 a 或 an 視名詞開頭發音而定。",
      "examples": [
        {
          "en": "This is a red square.",
          "zh": "這是一個紅色的正方形。"
        },
        {
          "en": "That is an oval.",
          "zh": "那是一個橢圓形。"
        },
        {
          "en": "This is a big box.",
          "zh": "這是一個大箱子。"
        }
      ]
    }
  ],
