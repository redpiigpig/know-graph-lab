  "grammar_points": [
    {
      "title_zh": "① 可數名詞與不可數名詞的分辨",
      "explain_zh": "說明：可數名詞可以用 a／an 或加複數 s，不可數名詞不能。兩者都可以用 some 與 any。",
      "table": [
        [
          "名詞",
          "可數/不可數",
          "例句"
        ],
        [
          "pie",
          "可數",
          "a pie / two pies"
        ],
        [
          "rice",
          "不可數",
          "some rice / any rice"
        ]
      ]
    },
    {
      "title_zh": "② some 用在肯定句，any 用在否定與疑問句",
      "explain_zh": "說明：肯定句用 some，否定句和疑問句用 any。",
      "examples": [
        {
          "en": "I have some rice.",
          "zh": "我有一些米飯。"
        },
        {
          "en": "She doesn't have any bread.",
          "zh": "她沒有任何麵包。"
        },
        {
          "en": "Do you have any noodles?",
          "zh": "你有麵條嗎？"
        }
      ]
    }
