  "grammar_points": [
    {
      "title_zh": "① I like… / Do you like…?",
      "explain_zh": "用來表達自己喜歡什麼，或詢問對方是否喜歡某樣東西。",
      "table": [
        [
          "英文句型",
          "中文說明",
          "例子"
        ],
        [
          "I like + 名詞。",
          "我喜歡……",
          "I like pizza."
        ],
        [
          "Do you like + 名詞？",
          "你喜歡……嗎？",
          "Do you like noodles?"
        ],
        [
          "Yes, I like… / No, I don't like…。",
          "是的，我喜歡…… / 不，我不喜歡……。",
          "Yes, I like rice. / No, I don't like beef."
        ]
      ]
    },
    {
      "title_zh": "② 可數名詞與不可數名詞",
      "explain_zh": "可數名詞可以用 a/an、複數形；不可數名詞不能用 a/an、通常不加 s，表示整體或抽象概念。",
      "examples": [
        {
          "en": "I have an apple.",
          "zh": "我有一個蘋果。"
        },
        {
          "en": "She eats rice every day.",
          "zh": "她每天吃米飯。"
        },
        {
          "en": "They bought three sandwiches.",
          "zh": "他們買了三個三明治。"
        },
        {
          "en": "We need some butter for the bread.",
          "zh": "我們需要一些奶油來塗麵包。"
        }
      ]
    }
  ],
