  "grammar_points": [
    {
      "title_zh": "① a/an 與 the 的分工",
      "explain_zh": "第一次提到不特定的事物用 a/an；第二次或以後已經知道是哪一個時用 the。",
      "table": [
        [
          "使用時機",
          "例句",
          "中文"
        ],
        [
          "第一次提到，不特定",
          "I see a flower.",
          "我看見一朵花。"
        ],
        [
          "已經知道是哪一個",
          "The flower is red.",
          "這朵花是紅色的。"
        ]
      ]
    },
    {
      "title_zh": "② 獨一無二的自然物加 the，專有名詞不加",
      "explain_zh": "世界上只有一個的太陽、月亮、地球等前面要加 the；湖泊、山峰、島嶼等專有名詞則不加 the。",
